/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'

/index-*
  Cache-Control: public, max-age=31536000, immutable

/codelia.otf
  Cache-Control: public, max-age=86400

/icon.png
  Cache-Control: public, max-age=86400
